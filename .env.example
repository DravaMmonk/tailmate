# Local environment template for Tailmate.
# Copy this file to `.env` and replace all placeholder values before local runs.

# Google Cloud basis
TAILMATE_PROJECT_ID=your-project-id
TAILMATE_LOCATION=your-region
# Gemini-backed dog_profile extraction uses the global Vertex endpoint by default in LOCAL.
TAILMATE_GEMINI_LOCATION=global

# Runtime mode
TAILMATE_ENV=LOCAL

# Agent configuration
TAILMATE_AGENT_NAME=tailmate_root
TAILMATE_SERVICE_ACCOUNT=tailmate-agent@your-project-id.iam.gserviceaccount.com

# Database
TAILMATE_DB_USER=postgres
# Prefer a Secret Manager version resource in every environment where ADC is available:
# projects/your-project-id/secrets/cloudsql-password/versions/latest
TAILMATE_DB_PASSWORD=your-password
# Cloud-only host value used when TAILMATE_ENV=CLOUD.
# In CLOUD this should be the Cloud SQL private IP exposed to the runtime through the configured network attachment.
TAILMATE_DB_IP=10.0.0.10
TAILMATE_DB_NAME=postgres

# Gateway direct database contract
# The Cloud Run gateway reads the validated DB_* contract below instead of the app-level TAILMATE_DB_* names.
# These values can point at the local Cloud SQL Auth Proxy for LOCAL gateway runs or a private Cloud SQL endpoint in CLOUD.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
# Prefer a Secret Manager version resource for CLOUD deployments when Cloud Run can resolve it directly.
DB_PASSWORD=your-password
DB_NAME=postgres
DB_CONNECT_TIMEOUT_SECONDS=10

# Dog-profile extraction
TAILMATE_GEMINI_FLASH_MODEL=gemini-2.5-flash
TAILMATE_GEMINI_PRO_MODEL=gemini-2.5-pro

# Storage
# Required in CLOUD mode. LOCAL resolves logical asset paths under TAILMATE_LOCAL_MEDIA_ROOT.
TAILMATE_MEDIA_BUCKET=your-media-bucket
# Optional in LOCAL mode. Logical asset paths resolve under this local root.
TAILMATE_LOCAL_MEDIA_ROOT=/data/tailmate
TAILMATE_LOCAL_TUNNEL_HOST=127.0.0.1
TAILMATE_LOCAL_TUNNEL_PORT=5432

# Agent Engine
# Required in CLOUD direct-database mode.
TAILMATE_NETWORK_ATTACHMENT=projects/your-project-id/regions/your-region/networkAttachments/your-attachment
# Optional in CLOUD. Set this instead of TAILMATE_NETWORK_ATTACHMENT to use the Cloud Run DB gateway path.
# TAILMATE_DB_GATEWAY_URL=https://tailmate-db-gateway-xxxxx-ts.a.run.app
# Optional in CLOUD gateway mode. Defaults to 30 seconds.
# TAILMATE_DB_GATEWAY_TIMEOUT_SECONDS=30
# Required by the gateway service itself when TAILMATE_ENV=CLOUD.
# Use the exact served Cloud Run URL as the ID-token audience.
# TAILMATE_DB_GATEWAY_AUTH_AUDIENCE=https://tailmate-db-gateway-xxxxx-ts.a.run.app
# Comma-separated service account emails and/or token subject ids allowed to call write endpoints.
# TAILMATE_DB_GATEWAY_ALLOWED_CALLERS=tailmate-agent@your-project-id.iam.gserviceaccount.com
# Optional hard cap for sanitized uploads handled by the gateway. Defaults to 52428800 (50 MiB).
# TAILMATE_DB_GATEWAY_MAX_UPLOAD_BYTES=52428800
# Optional override for video metadata sanitization. Defaults to `ffmpeg`.
# FFMPEG_BINARY=/usr/bin/ffmpeg
# Optional in CLOUD mode.
# Leave these unset when the runtime connects directly to a private endpoint IP.
# Set them only when Agent Engine must resolve private Cloud DNS names through DNS peering.
# TAILMATE_DNS_PEERING_DOMAIN=example.internal.
# TAILMATE_DNS_PEERING_TARGET_PROJECT=your-project-id
# TAILMATE_DNS_PEERING_TARGET_NETWORK=default

# Local Cloud SQL Auth Proxy settings for `./scripts/start_cloudsql_proxy.sh`
CLOUDSQL_INSTANCE_CONNECTION_NAME=your-project-id:your-region:your-cloudsql-instance
LOCAL_PORT=5432
