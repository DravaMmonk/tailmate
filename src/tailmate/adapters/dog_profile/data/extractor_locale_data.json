  "regex_groups": {
    "clause_split": {
      "patterns_by_locale": {
        "shared": [
          "[，。,.!?！？;；\\n]+"
        ]
      }
    },
    "text_split": {
      "flags": [
        "IGNORECASE"
      ],
      "patterns_by_locale": {
        "shared": [
          "\\s*(?:,|，|/|、|;|；|\\band\\b|\\bwith\\b|和|及)\\s*"
        ]
      }
    },
    "kg": {
      "flags": [
        "IGNORECASE"
      ],
      "patterns_by_locale": {
        "shared": [
          "(?P<value>\\d+(?:\\.\\d+)?)\\s*(?:公斤|千克|kg|kgs?)\\b"
        ]
      }
    },
    "jin": {
      "patterns_by_locale": {
        "zh-Hans": [
          "(?P<value>\\d+(?:\\.\\d+)?)\\s*斤"
        ]
      }
    },
    "lb": {
      "flags": [
        "IGNORECASE"
      ],
      "patterns_by_locale": {
        "shared": [
          "(?P<value>\\d+(?:\\.\\d+)?)\\s*(?:lb|lbs|pounds?|磅)\\b"
        ]
      }
    },
    "birthdate": {
      "flags": [
        "IGNORECASE"
      ],
      "patterns_by_locale": {
        "zh-Hans": [
          "(?:出生于|生于)\\s*(?P<date>\\d{4}[年/\\-.]\\d{1,2}[月/\\-.]\\d{1,2}日?)"
        ],
        "en": [
          "(?:born on|born in)\\s*(?P<date>\\d{4}[./-]\\d{1,2}[./-]\\d{1,2})"
        ]
      }
    },
    "age_month_half": {
      "flags": [
        "IGNORECASE"
      ],
      "patterns_by_locale": {
        "zh-Hans": [
          "(?P<value>[一二三四五六七八九十两\\d]+)\\s*个半月"
        ],
        "en": [
          "(?P<value>[一二三四五六七八九十两\\d]+)\\s*(?:months?|mos?|mo)\\s+and\\s+a\\s+half"
        ]
      }
    },
    "age_month": {
      "flags": [
        "IGNORECASE"
      ],
      "patterns_by_locale": {
        "shared": [
          "(?P<value>[一二三四五六七八九十两\\d]+(?:\\.\\d+)?)\\s*(?:个月|月|months?|mos?|mo)\\b"
        ]
      }
    },
    "age_year": {
      "flags": [
        "IGNORECASE"
      ],
      "patterns_by_locale": {
        "shared": [
          "(?P<value>[一二三四五六七八九十两\\d]+(?:\\.\\d+)?)\\s*(?:岁|years?|yrs?|yo|y/o)\\s*(?P<half>half|半)?",
          "(?P<value>[一二三四五六七八九十两\\d]+)\\s*岁半"
        ]
      }
    },
    "allergy": {
      "flags": [
        "IGNORECASE"
      ],
      "patterns_by_locale": {
        "zh-Hans": [
          "对\\s*(?P<value>[^，。,.!?！？;；\\n]+?)\\s*过敏"
        ],
        "en": [
          "(?:allergic to|allergy to|sensitive to)\\s+(?P<value>[^，。,.!?！？;；\\n]+)"
        ]
      }
    },
    "medication": {
      "flags": [
        "IGNORECASE"
      ],
      "patterns_by_locale": {
        "zh-Hans": [
          "(?:在吃|正在用|在用)\\s*(?P<value>[^，。,.!?！？;；\\n]+)"
        ],
        "en": [
          "(?:currently taking|taking|currently on)\\s*(?P<value>[^，。,.!?！？;；\\n]+)",
          "(?:medication|medications|meds?)\\s*[:：]?\\s*(?P<value>[^，。,.!?！？;；\\n]+)"
        ]
      }
    },
    "medical_history": {
      "flags": [
        "IGNORECASE"
      ],
      "patterns_by_locale": {
        "zh-Hans": [
          "(?P<value>[^，。,.!?！？;；\\n]+做过手术)"
        ],
        "en": [
          "(?:history of|diagnosed with|previously had)\\s+(?P<value>[^，。,.!?！？;；\\n]+)"
        ]
      }
    },
    "dog_name": {
      "flags": [
        "IGNORECASE"
      ],
      "patterns_by_locale": {
        "zh-Hans": [
          "(?:我家|我的)\\s*([A-Za-z0-9\\u4e00-\\u9fff_-]{1,20})\\s*是",
          "(?:我家|我的)?(?:狗狗|小狗|狗子|狗).*?(?:叫|名叫|名字叫|是)\\s*([A-Za-z0-9\\u4e00-\\u9fff_-]{1,20})"
        ],
        "en": [
          "my dog\\s+([A-Za-z][A-Za-z0-9_-]{0,19})\\s+(?:is|was)",
          "(?:my dog(?:'s name)?\\s*(?:is|=)|dog named|called)\\s+([A-Za-z][A-Za-z0-9_-]{0,19})"
        ],
        "shared": [
          "^([A-Za-z0-9\\u4e00-\\u9fff_-]{1,20})\\s*(?:是|,|，).*(?:岁|月|公斤|kg|手术|过敏|绝育|surgery|allergic)"
        ]
      }
    }
  },
  "regex_label_groups": {
    "sex_single_token": {
      "male": {
        "patterns_by_locale": {
          "zh-Hans": [
            "(?:^|[\\s，。,.!?！？;；:：/()（）]|是)公(?:$|[\\s，。,.!?！？;；:：/()（）])"
          ]
        }
      },
      "female": {
        "patterns_by_locale": {
          "zh-Hans": [
            "(?:^|[\\s，。,.!?！？;；:：/()（）]|是)母(?:$|[\\s，。,.!?！？;；:：/()（）])"
          ]
        }
      }
    }
  },
